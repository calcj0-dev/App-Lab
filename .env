# Public site URL (ends with "/"). Used for canonical, og:url, og:image, sitemap (設計書 4.4).
# Vercel environment variables override this if set there.
VITE_SITE_URL=https://app-lab-rust.vercel.app/

# Google Search Console HTML-tag verification value (owner sets it in Vercel). Empty = no tag.
VITE_GSC_VERIFICATION=
